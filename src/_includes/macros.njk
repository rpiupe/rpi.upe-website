{% macro contact(startOfSentence) -%}
{% if chapter.email %}{{ "Email" if startOfSentence else "email" }} <a href="mailto:{{ chapter.email }}">{{ chapter.email }}</a>{% else %}{{ "Tell" if startOfSentence else "tell" }} an officer at the next chapter meeting{% endif %}
{%- endmacro %}

{% macro stale(verified) -%}
{% if verified < build.staleBefore %}<p class="notice">Last confirmed {{ verified | monthYear }}. If this is out of date, {{ contact() }}.</p>{% endif %}
{%- endmacro %}

{% macro tba(value) -%}
{% if value %}{{ value }}{% else %}<span class="tba">To be announced</span>{% endif %}
{%- endmacro %}

{% macro membershipStatus() -%}
{% if membership.deadline and membership.deadline >= build.today %}
<p>Applications for {{ membership.term }} are open until {{ membership.deadline | longDate }}.</p>
<p><a class="button" href="{{ membership.application_url }}">Apply to join UPE (opens a Google Form)</a></p>
{% elif membership.deadline %}
<p class="tba-block">The {{ membership.term }} application closed on {{ membership.deadline | longDate }}. The next cycle will be announced here.</p>
{% else %}
<p class="tba-block">The next application cycle will be announced here.</p>
{% endif %}
{%- endmacro %}

{% macro event(e, headingLevel) -%}
<article class="event">
  <h{{ headingLevel }}>{{ e.title }}</h{{ headingLevel }}>
  <p class="event-meta"><time datetime="{{ e.date }}">{{ e.date | longDate }}</time>{% if e.time %}, {{ e.time }}{% endif %}{% if e.location %}, {{ e.location }}{% endif %}{% if e.kind == "io" %} <span class="tag">I/O talk</span>{% endif %}</p>
  <p>{{ e.description }}</p>
  {% if e.link %}<p><a href="{{ e.link }}">Details for {{ e.title }}</a></p>{% endif %}
</article>
{%- endmacro %}
